# ==========================================
# Root .gitignore for Flutter & Node.js Repo
# ==========================================

# Environment variables & secrets
.env

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
*.swn
*.sublime-project
*.sublime-workspace
*.iml
*.ipr
*.iws

# Logs & debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Node.js & Backend
# ==========================================
node_modules/
backend/node_modules/
backend/dist/
backend/build/
.npm
.yarn/cache
.yarn/unplugged
.pnp
.pnp.js

# ==========================================
# Flutter & Dart (tracking_app)
# ==========================================
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/

tracking_app/.dart_tool/
tracking_app/.flutter-plugins
tracking_app/.flutter-plugins-dependencies
tracking_app/.packages
tracking_app/.pub-cache/
tracking_app/.pub/
tracking_app/build/
tracking_app/coverage/

# Android specific (in Flutter)
**/android/.gradle/
**/android/captures/
**/android/gradleBuild/
**/android/local.properties
**/android/*.iml
**/android/app/*.iml
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/key.properties
**/*.jks
**/*.keystore

# iOS / macOS specific (in Flutter)
**/ios/Flutter/.last_build_id
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*
**/ios/*.xcworkspace/xcuserdata/
**/ios/*.xcodeproj/xcuserdata/
**/ios/*.xcodeproj/project.xcworkspace/xcuserdata/

# Symbols & Obfuscation
app.*.symbols
app.*.map.json
*.symbols
*.map.json
.widget_preview/

# Temporary / Scratch files
tmp/
temp/
*.tmp

